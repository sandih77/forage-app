<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
        http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- Active les annotations comme @Controller, @RequestMapping -->
    <mvc:annotation-driven />

    <!-- Indique à Spring où chercher vos contrôleurs (Adaptez le package) -->
    <context:component-scan base-package="com.core.forage_app" />

    <!-- Gestion des ressources statiques (CSS, JS) -->
    <mvc:resources mapping="/static/**" location="classpath:/static/" />

    <!-- CONFIGURATION DE THYMELEAF -->
    
    <!-- 1. Le Template Resolver (Où sont les fichiers HTML et leur extension) -->
    <bean id="templateResolver" class="org.thymeleaf.spring6.templateresolver.SpringResourceTemplateResolver">
        <property name="prefix" value="classpath:/templates/" />
        <property name="suffix" value=".html" />
        <property name="templateMode" value="HTML" />
        <property name="characterEncoding" value="UTF-8" />
        <property name="cacheable" value="false" /> <!-- Désactivé pour le dev -->
    </bean>

    <!-- 2. Le Template Engine -->
    <bean id="templateEngine" class="org.thymeleaf.spring6.SpringTemplateEngine">
        <property name="templateResolver" ref="templateResolver" />
    </bean>

    <!-- 3. Le View Resolver qui fait le lien avec Spring MVC -->
    <bean class="org.thymeleaf.spring6.view.ThymeleafViewResolver">
        <property name="templateEngine" ref="templateEngine" />
        <property name="characterEncoding" value="UTF-8" />
    </bean>

</beans>